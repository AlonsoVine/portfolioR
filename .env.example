# EmailJS · necesarias para el formulario de contacto
# Saca los valores del dashboard de EmailJS y copia este archivo como .env.local
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Subpath de GitHub Pages · normalmente no hace falta en local.
# Si quieres probar el subpath /portfolioR localmente, descomenta:
# NEXT_PUBLIC_BASE_PATH=/portfolioR
